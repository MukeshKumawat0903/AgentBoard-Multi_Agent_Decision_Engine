# ============================================================
# AgentBoard backend configuration — copy to backend/.env
# Every value below is the built-in default unless marked REQUIRED.
# Variable names are case-sensitive.
# ============================================================

# --- Application ---------------------------------------------
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
# Rotating log file directory (relative paths: under backend/)
LOG_DIR=logs
# JSON list of browser origins allowed to call the API directly
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM provider ------------------------------------------------
# groq | openai | anthropic | gemini
LLM_PROVIDER=groq

# The key of the provider selected above is required; the others are optional.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Debate engine -------------------------------------------
# Mode used when a debate or simulation doesn't choose one, and the mode the
# UI pre-selects: quick | standard | thorough (quick when not set).
DEFAULT_DEBATE_MODE=quick
# Fallbacks used only when the graph runs without a mode preset
# (API requests always resolve quick/standard/thorough presets).
MAX_DEBATE_ROUNDS=2
MIN_DEBATE_ROUNDS=2
CONSENSUS_THRESHOLD=0.75
ENABLED_AGENTS=Analyst,Risk,Strategy,Ethics,Moderator
AGENT_PROPOSAL_TIMEOUT=45
AGENT_CRITIQUE_TIMEOUT=45
AGENT_REVISION_TIMEOUT=45
AGENT_TOOL_TIMEOUT_MULTIPLIER=1.5
MAX_TOOL_CALLS_PER_ROUND=3
# Max LLM calls in flight per provider (0 = unlimited)
LLM_MAX_CONCURRENCY=4

# --- Consensus gate tuning -----------------------------------
DRIFT_EARLY_STOP_THRESHOLD=0.05
MINORITY_REPORT_BAND=0.20
ALL_CONFIDENT_THRESHOLD=0.9
CONFIDENCE_CONVERGENCE_SPREAD=0.15
MAX_DISSENTERS_FOR_CONSENSUS=1
MAX_OPEN_DISAGREEMENTS_FOR_CONSENSUS=2
CONSENSUS_POSITION_WEIGHT=0.3
# Raw word-overlap mapped to 0 (unrelated positions) .. 1 (same stance reworded)
POSITION_OVERLAP_FLOOR=0.08
POSITION_OVERLAP_CEILING=0.19
# How Rule 1 measures agreement: stance (agents vote; default) | lexical (word
# overlap; also the fallback) | semantic (embeddings; needs the flag below)
AGREEMENT_METHOD=stance
# Embedding similarity needs sentence-transformers installed. When true it is
# logged/emitted every round and the "semantic" method becomes available; it
# does not change the agreement score unless that method is chosen.
SEMANTIC_CONSENSUS_ENABLED=false
SEMANTIC_MODEL=all-MiniLM-L6-v2
SEMANTIC_CONSENSUS_WEIGHT=0.5

# --- Persistence ---------------------------------------------
# Relative paths are resolved against the backend/ directory.
DATABASE_URL=agentboard.db
CHECKPOINT_DATABASE_URL=agentboard_checkpoints.db
DEBATE_TTL_DAYS=90

# --- Knowledge base (RAG) ------------------------------------
KNOWLEDGE_BASE_DIR=knowledge_base
KB_EMBEDDING_MODEL=all-MiniLM-L6-v2
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200
KB_SIMILARITY_THRESHOLD=0.30
KB_TOP_K=5
KB_MAX_FILE_MB=10

# --- Human-in-the-loop ---------------------------------------
HITL_ENABLED=true

# --- Admin actions -------------------------------------------
# Token (sent as X-Admin-Token) for switching the LLM provider, clearing agent
# memory and deleting KB documents. Empty: open in development, refused in production.
ADMIN_API_TOKEN=

# --- Rate limiting -------------------------------------------
RATE_LIMIT_PER_MINUTE=30
# IPs/CIDRs of proxies in front of the API (Next.js server, edge proxy);
# their X-Forwarded-For is used as the client address
TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- LangSmith tracing (optional) ----------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentboard
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
